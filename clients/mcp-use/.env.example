# Copy this file to .env and fill in the values. Do NOT commit your real .env.

# --- BurpMCP-Ultra MCP SSE server ---------------------------------------------
# The URL + token are shown in Burp -> BurpMCP-Ultra -> Server tab.
# Use 9876 (primary) or 9877 (secondary), or your Caddy port (9900) if proxied.
BURP_MCP_URL=http://127.0.0.1:9876/
BURP_MCP_TOKEN=

# --- Venice AI (OpenAI-compatible) --------------------------------------------
# Get an API key at https://venice.ai. VENICE_MODEL must be a model that supports
# function/tool calling (check the /models endpoint's supportsFunctionCalling flag).
VENICE_API_KEY=
VENICE_MODEL=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_TEMPERATURE=0.2

# --- Agent behaviour ----------------------------------------------------------
AGENT_MAX_STEPS=25
